#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
LC_ALL=C
export LC_ALL

init_dir=${INIT_DIR:-/etc/init.d}

# K scripts run in reverse order so K00mount always unmounts last.
priority=99
while [ "$priority" -ge 0 ]; do
  number=$(printf '%02d' "$priority")
  for script in "$init_dir"/K"$number"*; do
    [ -f "$script" ] || continue
    if [ ! -x "$script" ]; then
      echo "Skipping non-executable shutdown script: $script"
      continue
    fi

    echo "Stopping ${script##*/}"
    if ! "$script" stop; then
      echo "Shutdown script failed: $script" >&2
    fi
  done
  priority=$((priority - 1))
done

exit 0
