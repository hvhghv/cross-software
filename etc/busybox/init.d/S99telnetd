#!/bin/sh

pidfile=/run/telnetd.pid

is_telnetd_pid() {
  pid=$1
  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ -r "/proc/$pid/comm" ] || return 1
  IFS= read -r process_name < "/proc/$pid/comm" || return 1
  case "$process_name" in
    telnetd) return 0 ;;
    busybox) ;;
    *) return 1 ;;
  esac
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\000' '\n' < "/proc/$pid/cmdline" | grep -Eq '(^|/)telnetd$'
}

start_telnetd() {
  if [ -s "$pidfile" ]; then
    pid=$(cat "$pidfile")
    if is_telnetd_pid "$pid" && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi

  rm -f "$pidfile"
  mkdir -p /run /var/log
  telnetd -F -K -l /bin/login > /var/log/telnetd.log 2>&1 &
  pid=$!
  printf '%s\n' "$pid" > "$pidfile"

  sleep 1
  if ! is_telnetd_pid "$pid" || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$pidfile"
    echo "telnetd failed to start" >&2
    return 1
  fi
}

stop_telnetd() {
  if [ -s "$pidfile" ]; then
    pid=$(cat "$pidfile")
    if is_telnetd_pid "$pid" && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      attempts=0
      while is_telnetd_pid "$pid" && kill -0 "$pid" 2>/dev/null; do
        [ "$attempts" -lt 5 ] || break
        sleep 1
        attempts=$((attempts + 1))
      done
      if is_telnetd_pid "$pid" && kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    fi
    rm -f "$pidfile"
  fi
}

status_telnetd() {
  if [ -s "$pidfile" ]; then
    pid=$(cat "$pidfile")
    if is_telnetd_pid "$pid" && kill -0 "$pid" 2>/dev/null; then
      echo "telnetd is running (pid $pid)"
      return 0
    fi
  fi

  echo "telnetd is stopped"
  return 3
}

action=${1:-start}
case "$action" in
  start)
    start_telnetd
    ;;
  stop)
    stop_telnetd
    ;;
  restart)
    stop_telnetd && start_telnetd
    ;;
  status)
    status_telnetd
    ;;
  *)
    echo "Usage: $0 [start|stop|restart|status]" >&2
    exit 2
    ;;
esac
