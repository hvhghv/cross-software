#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
LC_ALL=C
export LC_ALL

init_dir=${INIT_DIR:-/etc/init.d}

for script in "$init_dir"/S[0-9][0-9]*; do
  [ -f "$script" ] || continue
  if [ ! -x "$script" ]; then
    echo "Skipping non-executable startup script: $script"
    continue
  fi

  echo "Starting ${script##*/}"
  if ! "$script" start; then
    echo "Startup script failed: $script" >&2
  fi
done

exit 0
