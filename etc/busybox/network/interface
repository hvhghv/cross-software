# BusyBox ifupdown configuration read with:
#   ifup -a -i /etc/network/interface

auto lo
iface lo inet loopback

# Add an interface to an "auto" line to start it during boot.
#
# DHCP example:
# auto eth0
# iface eth0 inet dhcp
#     dns-nameservers 223.5.5.5 1.1.1.1
